APP_NAME=Personal Scholar Agent API
API_PREFIX=/api
DATA_DIR=data
TEMPLATES_DIR=templates
CORS_ORIGINS=*
MAX_CHUNK_CHARS=900
CHUNK_OVERLAP=120
LLM_MODEL_NAME=DemoPipeline-v1
EMBEDDING_MODEL_NAME=TokenOverlapRetriever-v1
MODEL_PROVIDER=LocalRuleEngine
PIPELINE_MODE=DeterministicDraft
DEEPSEEK_API_KEY=your-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SEC=45

# Agent runtime
AGENT_MAX_ITERATIONS=12
AGENT_SERVICE_ROLE=all-in-one
AGENT_NATIVE_CHAT_ENABLED=true
CHAT_BACKEND=native
PIPELINE_BACKEND=orchestrator
LEGACY_CHAT_FALLBACK_ENABLED=false
LEGACY_PIPELINE_FALLBACK_ENABLED=false
DEFAULT_COLLABORATION_MODE=tot
SUB_AGENT_STORE_AUTO_FALLBACK=true
REDIS_URL=

# Sandbox (Docker) — set SANDBOX_ENABLED=true when Docker is available
SANDBOX_ENABLED=false
SANDBOX_DOCKER_IMAGE=python:3.12-slim
SANDBOX_TIMEOUT_SEC=120
SANDBOX_WORKSPACE_ROOT=data/sandbox
SANDBOX_NETWORK_ENABLED=false

# ---- 向量库（Chroma）----
# local=进程内持久化（开发默认）；server=独立 Chroma 服务（生产推荐，配合 docker 部署 chroma）
VECTOR_STORE_MODE=local
VECTOR_SERVER_URL=
# 换 embedding 模型时按 模型+schema 生成隔离集合名，避免不同维度向量混库
VECTOR_COLLECTION_VERSIONED=false

# ---- VLM 图表描述 ----
# sync=管线内等待完成；async=后台执行（上传秒级入库，描述异步补全）
VLM_MODE=sync
